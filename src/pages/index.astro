---
import Base from '../layouts/Base.astro';
import WorkGrid from '../components/WorkGrid.astro';
import { pageSchema, pageSeo, person, site } from '../lib/content';
import type { Project } from '../lib/content';
import { responsive } from '../lib/images';

// Projects shown under "Selected work", in this order. Use the slug from a project's address (marichoo.com/<slug>).
const FEATURED = [
  'the-big-5-illustration-for-brigitte-leben',
  'gucci-bloom',
  'work-flow-illustration-for-gesund-de',
  'lets-keep-our-sea-plastic-free',
  'illustrations-for-playboy-netherlands',
  'illustrations-for-chefsfeed',
  'llustration-fur-gesund-de-magazin',
  'overtime-employee-of-the-month',
  'bubble',
];

const CLIENTS = ['Brigitte', 'Gesund.de', 'L-Mag', 'Playboy', 'ChefsFeed', 'BBDO', 'Beck’s', 'Podravka', 'Dukat', 'Henschel', 'Wrigley', 'Lactalis'];

const DISCIPLINES = [
  { href: '/portfolio/illustration', title: 'Illustration', text: 'Editorial, fashion, food and portrait illustration for magazines, brands and books.' },
  { href: '/portfolio/graphic-design', title: 'Graphic design', text: 'Branding, campaigns, newsletters, packaging and print, from concept to final artwork.' },
  { href: '/portfolio/art-installation', title: 'Art & exhibitions', text: 'Posters, installations and festival work shown in solo and group exhibitions.' },
];

const seo = pageSeo.home;
const hero = await responsive('/media/Quarantine-illustration.jpg', 1200);
const portrait = await responsive(site.pages.home.image?.src, 800);
const work = FEATURED.map((slug) => site.projects.find((project) => project.slug === slug)).filter(
  (project): project is Project => Boolean(project),
);
---

<Base title={seo.title} description={seo.description} image={site.pages.home.image?.src} schema={[pageSchema('home')]}>
  <section class="home-hero section-inner">
    <div class="home-hero-text">
      <p class="eyebrow rise" style="--i: 0">{person.name} · Illustrator, graphic designer &amp; artist</p>
      <h1 class="home-title">
        <span class="rise" style="--i: 1">Figurative, clean,</span>
        <span class="rise" style="--i: 2">graphic &amp; <em>colourful</em></span>
        <span class="rise" style="--i: 3">illustration.</span>
      </h1>
      <p class="home-intro rise" style="--i: 4">
        Hi, I’m Marichoo, an illustrator, graphic designer &amp; artist with a quirky mind. Inspired by everyday life and people.
      </p>
      <p class="home-actions rise" style="--i: 5">
        <a class="button" href="#work">See selected work</a>
        <a class="text-link" href="/contact">Get in touch</a>
      </p>
    </div>
    {
      hero && (
        <figure class="home-hero-image">
          <span class="hero-frame">
          <img
            src={hero.src}
            srcset={hero.srcset}
            sizes="(min-width: 1000px) 44vw, (min-width: 700px) 60vw, 90vw"
            width={hero.width}
            height={hero.height}
            alt="Quarantine illustration: one young woman shown several times in a small kitchen, washing up, reading and drinking coffee"
            fetchpriority="high"
            decoding="async"
          />
          </span>
        </figure>
      )
    }
  </section>

  <section id="work" class="home-work section-inner" aria-labelledby="work-title">
    <div class="section-head">
      <h2 id="work-title" class="section-title">Selected work</h2>
      <a class="text-link" href="/portfolio">All projects</a>
    </div>
    <WorkGrid projects={work} />
  </section>

  <section class="home-about section-inner" aria-labelledby="about-title">
    {
      portrait && (
        <figure class="home-about-portrait reveal">
          <img src={portrait.src} srcset={portrait.srcset} sizes="(min-width: 1000px) 36vw, 80vw" width={portrait.width} height={portrait.height} alt={`${person.name}, illustrated self-portrait`} loading="lazy" decoding="async" />
        </figure>
      )
    }
    <div class="home-about-text reveal">
      <p class="eyebrow">Hello, I’m Marija</p>
      <h2 id="about-title" class="home-quote">“I would describe my style as figurative, clean, graphic &amp; <em>colourful</em>.”</h2>
      <p>
        My biggest inspiration comes from everyday life, which, seen from another perspective, can be magical, beautiful and absurd. I also love medieval art, full of detail, life and humour. Every project starts with a lot of writing, then sketches, then the final drawing in Procreate.
      </p>
      <dl class="home-facts">
        <div><dt>15+</dt><dd>years in agencies &amp; freelance</dd></div>
        <div><dt>M.A.</dt><dd>Academy of Fine Arts, Zagreb</dd></div>
        <div><dt>3</dt><dd>languages: English, German, Croatian</dd></div>
      </dl>
      <a class="text-link" href="/about">More about me</a>
    </div>
  </section>

  <section class="home-disciplines section-inner" aria-labelledby="disciplines-title">
    <h2 id="disciplines-title" class="section-title">What I do</h2>
    <ul class="discipline-list">
      {
        DISCIPLINES.map((item) => (
          <li class="reveal">
            <a href={item.href}>
              <span class="discipline-title">{item.title}</span>
              <span class="discipline-text">{item.text}</span>
              <span class="discipline-arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))
      }
    </ul>
    <p><a class="text-link" href="/services">See services</a></p>
  </section>

  <section class="home-clients section-inner" aria-labelledby="clients-title">
    <h2 id="clients-title" class="eyebrow">Selected clients</h2>
    <ul class="client-list reveal">
      {CLIENTS.map((name) => <li>{name}</li>)}
    </ul>
  </section>
</Base>
