---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { SITE_NAME } from '../lib/content';
---

<Base title={`Page not found | ${SITE_NAME}`} description="This page does not exist. Browse Marichoo’s illustration and graphic design portfolio instead." noindex>
  <PageHeader title="Oops! This page seems to have wandered off." eyebrow={[{ label: 'Page not found' }]}>
    <p class="home-actions rise" style="--i: 2">
      <a class="button" href="/portfolio">See the portfolio</a>
      <a class="text-link" href="/">Go to the homepage</a>
    </p>
  </PageHeader>
</Base>
