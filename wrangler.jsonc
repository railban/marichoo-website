// Cloudflare Workers settings. The site is fully static: Cloudflare serves the built files in dist/ as they are.
{
  "name": "marichoo",
  "compatibility_date": "2026-10-01",
  // The site is only served on marichoo.com; keep the *.workers.dev addresses off so Google never sees a copy.
  "workers_dev": false,
  "preview_urls": false,
  // Pull request branches get a Cloudflare Preview build (the check on each pull request). Empty = same settings as the live site.
  "previews": {},
  "assets": {
    "directory": "./dist",
    // /about serves about.html (Astro builds pages as files).
    "html_handling": "auto-trailing-slash",
    // Unknown addresses show the site's own 404 page.
    "not_found_handling": "404-page"
  }
}
